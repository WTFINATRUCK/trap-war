# Authoritative API (apps/api). Copy to .env for local development.
# Start a local database with `docker compose up -d`.
DATABASE_URL=postgres://trap_wars:trap_wars_dev@localhost:5432/trap_wars
API_HOST=127.0.0.1
API_PORT=8787
LOG_LEVEL=info
AUTH_SESSION_TTL_SECONDS=86400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Exactly 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
# Never commit a real key.
RUN_SEED_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
