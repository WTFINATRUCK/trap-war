# ── Telegram bots (@BotFather) — use 2–3 admin bots ────────
# 1) MAIN — Mini App / invites / play
BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather
BOT_USERNAME=TrapWarBot

# 2) COMMUNITY — welcome + /rules in player chat (create second bot)
# COMMUNITY_BOT_TOKEN=
# COMMUNITY_BOT_USERNAME=TrapWarChatBot

# 3) GUARD — anti-spam + mod helpers (create third bot)
# GUARD_BOT_TOKEN=
# GUARD_BOT_USERNAME=TrapWarGuardBot

# Run all: npm run bot:all

# Public HTTPS URL of the Mini App (Vercel / custom domain)
# Telegram does NOT allow http://localhost for production Mini Apps
# Example: https://trap-war.vercel.app  or  https://trapwar.com
WEBAPP_URL=https://trapwar.com

# ── Official channel (announcements) ───────────────────────
# Create channel in Telegram → Public link (e.g. t.me/TrapWarOfficial)
CHANNEL_URL=https://t.me/TrapWarOfficial
# Optional: numeric id for join-checks (add bot as admin first)
# CHANNEL_ID=-1001234567890
# REQUIRE_CHANNEL=true

# ── Community chat (players talk) ──────────────────────────
# Create a PUBLIC group (or private + invite link), add the bot as admin,
# optionally link it as the channel's Discussion group.
# Then: .\scripts\set-community.ps1 -CommunityUrl "https://t.me/TrapWarChat"
COMMUNITY_URL=
# COMMUNITY_ID=-1001234567890

# ── Secure API (optional, bind localhost; reverse-proxy if needed) ──
API_PORT=8787
# API_CORS_ORIGIN=https://wtfinatruck.github.io

# Comma-separated Telegram user IDs that see full recent-user list on /stats
# Leave empty = everyone sees counts; with IDs = only admins see recent names
# ADMIN_IDS=8903745991

# M6 authoritative API and PostgreSQL runtime
DATABASE_URL=postgres://trap_wars:trap_wars_dev@localhost:5432/trap_wars
API_HOST=127.0.0.1
LOG_LEVEL=info
AUTH_SESSION_TTL_SECONDS=86400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
# Generate exactly 32 random bytes and encode them as base64. Never commit a real key.
RUN_SEED_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── Vite (in-game links — prefix VITE_) ────────────────────
VITE_BOT_USERNAME=TrapWarBot
VITE_CHANNEL_URL=https://t.me/TrapWarOfficial
VITE_COMMUNITY_URL=
VITE_WEBAPP_URL=https://your-trap-war.vercel.app
# VITE_API_URL=https://your-api.example.com
