{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/telegram.ts": {
      "maxDuration": 30,
      "includeFiles": "bot/**"
    },
    "api/setup-webhook.ts": {
      "maxDuration": 30,
      "includeFiles": "bot/**"
    }
  }
}
